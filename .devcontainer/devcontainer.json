{
    "name": "LLM-dev",
    "dockerComposeFile": "docker-compose.yml",
    "service": "llm_dev", 
    "workspaceFolder": "/workspace",
    "updateRemoteUserUID": true,
    "remoteUser": "user",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
            }
        }
    }
}