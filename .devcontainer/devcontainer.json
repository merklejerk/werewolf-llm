{
    "name": "LLM-dev",
    "dockerComposeFile": [ ".docker-compose.yml" ],
    "service": "llm_dev", 
    "workspaceFolder": "/workspace",
    "updateRemoteUserUID": true,
    "remoteUser": "user",
    "initializeCommand": [ "/bin/sh", "-c", "cd .devcontainer && ([ -f .env ] && . .env; ln -srf \"docker-compose.${BACKEND:-cpu}.yml\" \".docker-compose.yml\")" ],
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
            }
        }
    }
}